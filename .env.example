# Настройки развёртывания CRM ОР ПСД. Скопируйте в .env и заполните.
# Файл .env в репозиторий не коммитится (см. .gitignore).

# --- внешний адрес -----------------------------------------------------------
# Домен, по которому система доступна сотрудникам и Заказчикам.
SERVER_NAME=crm.example.kz
APP_ORIGIN=https://crm.example.kz
# Интерфейс, на котором слушает прокси. 0.0.0.0 — все; можно ограничить адресом.
BIND_ADDR=0.0.0.0

# --- база данных -------------------------------------------------------------
# Строка подключения целиком. Нужна при установке без Docker;
# в Docker Compose собирается автоматически из PGUSER/PGPASSWORD/PGDATABASE.
DATABASE_URL=postgres://qtr:пароль@localhost:5432/qtr_crm

PGUSER=qtr
PGDATABASE=qtr_crm
# Обязательно. Сгенерировать: openssl rand -base64 24
PGPASSWORD=

# --- корпоративный вход (OIDC) -----------------------------------------------
SSO_ENABLED=true
# Общий секрет между прокси и приложением, не короче 32 символов.
# Сгенерировать: openssl rand -hex 32
AUTH_PROXY_SHARED_SECRET=
OIDC_ISSUER_URL=https://sso.example.kz/realms/qtr
OIDC_CLIENT_ID=qtr-crm
OIDC_CLIENT_SECRET=
# Сгенерировать: openssl rand -base64 32 | head -c 32
OIDC_COOKIE_SECRET=
# Ограничение домена почты, * — без ограничения.
OIDC_EMAIL_DOMAIN=*

# --- первичная настройка -----------------------------------------------------
# Первый вход этого адреса создаёт администратора ДИТ, если администраторов ещё нет.
# После назначения ролей строку можно очистить.
BOOTSTRAP_ADMIN_EMAIL=

# --- файлы актов -------------------------------------------------------------
# Каталог хранения файлов. Резервируется отдельно от базы.
STORAGE_ROOT=/var/lib/qtr-crm/storage

# --- почтовые уведомления ----------------------------------------------------
# Пока выключено, сообщения копятся в очереди и не теряются.
SMTP_ENABLED=false
SMTP_HOST=smtp.example.kz
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CRM ОР ПСД <no-reply@example.kz>

# --- фоновые задания ---------------------------------------------------------
# Эскалация (п. 100), закрытие по оферте, приёмка по молчанию (п. 94),
# напоминания по оборудованию и срокам действия документов.
# При нескольких экземплярах приложения оставьте true только на одном узле.
JOBS_ENABLED=true
JOBS_INTERVAL_MINUTES=15

# --- прочее ------------------------------------------------------------------
# Применять миграции при старте приложения. По умолчанию выключено:
# на рабочем контуре миграции запускают вручную перед переключением.
MIGRATE_ON_START=false

# Обратный прокси для Docker Compose: TLS, ограничение частоты входа, передача в приложение.
#
# Вход — в самом приложении (почта, пароль, код на почту). Служебные заголовки
# X-QTR-*, пришедшие снаружи, стираются: они нужны только для необязательного
# корпоративного входа (SSO_ENABLED), который в этом составе не используется.

limit_req_zone $binary_remote_addr zone=qtr_auth:10m rate=10r/m;

server {
    listen 80;
    server_name ${SERVER_NAME};
    # Перенаправление на HTTPS, кроме проверки домена при выпуске сертификата.
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://${SERVER_NAME}$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SERVER_NAME};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    server_tokens off;
    client_max_body_size 25m;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header X-Frame-Options DENY always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # Запросы на чужое имя отбрасываются без ответа.
    if ($host != ${SERVER_NAME}) { return 444; }

    proxy_http_version 1.1;
    proxy_read_timeout 90s;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-QTR-Proxy-Key "";
    proxy_set_header X-QTR-User-Id "";
    proxy_set_header X-QTR-User-Email "";
    proxy_set_header X-QTR-User-Name "";

    # Вход, регистрация, восстановление пароля — не чаще 10 запросов в минуту с адреса.
    location /api/v1/auth/ {
        limit_req zone=qtr_auth burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://app:3000;
    }

    location / {
        proxy_pass http://app:3000;
    }
}
